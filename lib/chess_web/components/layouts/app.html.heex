<header class="w-full h-20 flex bg-green-300 border border-solid border-green-600">
  <div class="p-4 mr-auto flex justify-center items-center">Chess App</div>
  <ul class="p-4 gap-4 flex justify-center items-center">
    <li class="p-4 bg-green-400 border border-solid border-green-500 rounded-3xl">Games</li>
    <li class="p-4 bg-green-400 border border-solid border-green-500 rounded-3xl">Sign up</li>
    <li class="p-4 bg-green-400 border border-solid border-green-500 rounded-3xl">Log in</li>
  </ul>
</header>
<main class="bg-gray-300 px-4 py-20 sm:px-6 lg:px-8">
  <.flash_group flash={@flash} />
  {@inner_content}
</main>
<footer class="p-20 flex justify-center align-center">
  Footer with links, to github etc
</footer>
